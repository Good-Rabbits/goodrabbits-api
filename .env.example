# Application Settings
ENVIRONMENT=development
PROJECT_NAME="GoodRabbits API"
API_V1_STR="/api/v1"

# Security & CORS
# Add your Chrome Extension ID and authorized origins
ALLOWED_ORIGINS=["http://localhost:3000","chrome-extension://<EXTENSION_ID_PLACEHOLDER>"]

# Redis Configuration (Redis Cloud / Upstash / Local)
REDIS_URL="redis://localhost:6379/0"

# Firebase Admin Credentials
# Path to service account JSON file, or leave empty if using GOOGLE_APPLICATION_CREDENTIALS environment variable
FIREBASE_CREDENTIALS_PATH="./serviceAccountKey.json"

# Game Anti-Cheat & Reward Rates
XP_PER_MINUTE=10
CARROTS_PER_MINUTE=5
MINIMUM_FOCUS_SECONDS=60
MAX_SESSION_HOURS=4
